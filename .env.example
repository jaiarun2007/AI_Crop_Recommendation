# Copy to .env and fill in real values before running `docker compose up`.
# Never commit the actual .env file.

# Required: generate with `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`
JWT_SECRET_KEY=

# Optional: minutes before an access token expires
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: enables real LLM synthesis in the AI assistant (falls back to
# extractive retrieval automatically if unset)
ANTHROPIC_API_KEY=
